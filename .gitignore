# Secrets — NEVER commit. Copy config/secrets.example.json -> secrets.local.json locally.
config/secrets.local.json

# Python bytecode
__pycache__/
*.pyc

# Local caches & runtime state (reproducible: raw API caches, alert/news poller state+logs)
data/raw/
data/news/
data/alerts/

# Generated post drafts, the claims ledger and follow-up checklists. Working
# output, not source. The published posts kept as voice reference live in
# .claude/skills/earnings-post/references/examples.md and ARE tracked.
drafts/

# Claude Code project config. Local machine settings stay out; the earnings-post
# skill ships so a fresh clone can generate posts. Note `.claude/*` + negation:
# a plain `.claude/` would make the skill un-recoverable by any later rule.
.claude/*
!.claude/skills/
